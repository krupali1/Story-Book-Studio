# Copy to .env (docker compose reads it automatically). Set only what you use.

# ---- Access control ----------------------------------------------------------
# Leave GOOGLE_CLIENT_ID/SECRET blank for local/demo use: the app runs as one
# implicit "local" user with no login wall. Set them before exposing the app to
# the internet — every visitor then gets their own private, Google-authenticated
# library. Create these in Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID (type: Web application), with an authorized redirect URI of
# <your-public-url>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=       # optional override; derived from the request host otherwise
SESSION_SECRET=            # random string signing session cookies; auto-generated and
                           # persisted to DATA_DIR if left blank (fine for one instance)

# ---- Provider keys (the Providers dialog only offers those you set) --------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # also powers OpenAI image generation
GEMINI_API_KEY=            # GOOGLE_API_KEY works too; also powers Gemini images
STABILITY_API_KEY=         # images only (no reference-image support)

# Any OpenAI-compatible server: OpenRouter, Ollama, Groq, Together, vLLM, LM Studio...
# e.g. OpenRouter: https://openrouter.ai/api/v1   Ollama: http://host.docker.internal:11434/v1
COMPAT_BASE_URL=
COMPAT_API_KEY=
COMPAT_MODEL=

# ---- Optional: starting choices (the Providers dialog overrides these) -----
# brain/critic: anthropic | openai | gemini | openai_compatible | mock
# image:        openai | gemini | stability | mock
BRAIN_PROVIDER=
BRAIN_MODEL=
CRITIC_PROVIDER=
CRITIC_MODEL=
IMAGE_PROVIDER=
IMAGE_MODEL=

# ---- Optional: custom endpoints (proxies, Azure-style gateways) ------------
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=

# ---- Guard rails ------------------------------------------------------------
MAX_IMAGES_PER_TURN=6      # image generations per message: protects your bill
MAX_AGENT_STEPS=10         # tool-use rounds per message
MAX_UPLOAD_MB=10
DATA_DIR=./data            # library, sessions, images, settings (Docker uses /data)
